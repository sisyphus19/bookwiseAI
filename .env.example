# Copy to .env (never commit .env). Docker Compose reads it automatically for ${VAR} substitution,
# and settings.py reads it for host runs. Variables exported in a host shell are NOT visible
# inside containers unless compose passes them through (it now does for the ones below).

# --- LLM ---
# local | openai | ollama  ("local" = template text, no LLM)
LLM_PROVIDER=local
# required when LLM_PROVIDER=openai (also enables generated /catalog/ask answers)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_JOB_WAIT_SECONDS=25

# --- Only for running Python on the HOST (e.g. `python etl.py`) against the compose services ---
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/bookwise_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
